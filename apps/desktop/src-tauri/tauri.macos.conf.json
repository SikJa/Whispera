{
  "$schema": "https://schema.tauri.app/config/2",
  "app": { "macOSPrivateApi": true },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/cristal/icon.icns"],
    "resources": {
      "../node_modules/ffmpeg-static/ffmpeg": "bin/ffmpeg",
      "../node_modules/ffmpeg-static/ffmpeg.LICENSE": "bin/ffmpeg.LICENSE",
      "../node_modules/ffmpeg-static/ffmpeg.README": "bin/ffmpeg.README"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/SikJa/Whispera/releases/download/macos-preview/latest.json"]
    }
  }
}
