{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whispera",
  "version": "0.1.6",
  "identifier": "app.whispera.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5190",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whispera 2 - Configuracion",
        "width": 900,
        "height": 720,
        "minWidth": 620,
        "minHeight": 520,
        "visible": false,
        "backgroundColor": "#101011"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "SikJa",
    "license": "MIT",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../vendor/LICENSE": "vendor/LICENSE",
      "../public/sound-lab/HANDY-LICENSE.txt": "sound-lab/HANDY-LICENSE.txt",
      "../node_modules/ffmpeg-static/ffmpeg.exe": "bin/ffmpeg.exe",
      "../node_modules/ffmpeg-static/ffmpeg.exe.LICENSE": "bin/ffmpeg.LICENSE",
      "../node_modules/ffmpeg-static/ffmpeg.exe.README": "bin/ffmpeg.README"
    },
    "icon": [
      "icons/cristal/icon.png",
      "icons/cristal/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
