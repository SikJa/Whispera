{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whispera",
  "version": "0.2.23",
  "identifier": "app.whispera.desktop.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5190",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whispera · Configuración",
        "width": 900,
        "height": 720,
        "minWidth": 620,
        "minHeight": 520,
        "visible": false,
        "backgroundColor": "#101011",
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "SikJa",
    "license": "MIT",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../vendor/LICENSE": "vendor/LICENSE",
      "../public/sound-lab/HANDY-LICENSE.txt": "sound-lab/HANDY-LICENSE.txt",
      "../node_modules/ffmpeg-static/ffmpeg.exe": "bin/ffmpeg.exe",
      "../node_modules/ffmpeg-static/ffmpeg.exe.LICENSE": "bin/ffmpeg.LICENSE",
      "../node_modules/ffmpeg-static/ffmpeg.exe.README": "bin/ffmpeg.README"
    },
    "icon": [
      "icons/wave/icon.png",
      "icons/wave/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/wave/icon.ico",
        "uninstallerIcon": "icons/wave/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCRTVDNEZCREY2M0M1MjkKUldRcHhXUGYrOFRseXkvT3c2V25oN2pXTTY4TFNvd2d1Q25CRzBSK3BWUjljTkJnOXp5Sm5lUi8K",
      "endpoints": [
        "https://github.com/kazu00001/Whispera-K/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
